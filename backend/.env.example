# Backend Environment Configuration Template
# Copy this to .env and fill with your values

# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Prisma Database URL
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://postgres:password@localhost:5432/empire_forex"
# For Neon, use the pooled URL and set connection_limit per instance (start at 5)
# so total app connections remain below the Neon project limit.
DIRECT_URL="postgresql://postgres:password@localhost:5432/empire_forex"

# JWT & Security
# Required: generate a unique secret of at least 32 characters for each environment.
JWT_SECRET=development-jwt-secret-32chars!
JWT_ISSUER=empire-of-forex-api
JWT_AUDIENCE=empire-of-forex
GOOGLE_CLIENT_ID=

# CORS
CORS_ORIGIN=http://localhost:3000,https://empireoffx.com
CORS_CREDENTIALS=true

# API Keys
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_key

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@eofweb.com

# Admin Configuration
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
# Optional in development; configure a managed Redis URL in multi-instance production.
REDIS_URL=

# Features
ENABLE_KYC=true
ENABLE_2FA=false
ENABLE_EMAIL_VERIFICATION=true

# External APIs
FOREX_API_KEY=your_forex_api_key
MARKET_DATA_API_KEY=your_market_data_key
