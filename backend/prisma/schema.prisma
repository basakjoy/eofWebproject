generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminScope {
  SIGNAL_ADMIN
  CONTENT_ADMIN
  SUPER_ADMIN
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  resource        String?
  action          String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                      String                  @id @default(cuid())
  name                    String
  email                   String                  @unique
  password                String
  phone                   String?
  role                    String                  @default("user")
  roleId                  String?
  adminScope              AdminScope?
  adminScopeGrantedAt     DateTime?
  adminScopeGrantedBy     String?
  status                  String                  @default("active")
  lastLogin               DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  adminPermissions        AdminPermission[]
  adminUser               AdminUser?
  analysisCreated         Analysis[]              @relation("createdBy")
  analysisComments        AnalysisComment[]
  analysisReportsCreated  AnalysisReport[]        @relation("createdBy")
  brokerAccounts          BrokerAccount[]
  brokerComparisons       BrokerComparison[]
  brokersReviews          BrokerReview[]
  bulkNotifications       BulkNotification[]
  createdCampaigns        Campaign[]              @relation("createdBy")
  faqArticlesCreated      FaqArticle[]            @relation("createdBy")
  investments             Investment[]
  transactions            Transaction[]
  activityLogs            Log[]
  notificationHistory     NotificationHistory[]
  notificationPreferences NotificationPreference?
  notificationsReceived   Notification[]
  createdSignals          Signal[]                @relation("createdBy")
  supportAgent            SupportAgent?
  supportMessages         SupportMessage[]
  supportTicketsAssigned  SupportTicket[]         @relation("assignedTo")
  supportTicketsCreated   SupportTicket[]         @relation("createdBy")
  withdrawalAccounts      UserWithdrawalAccount[]
  userRole                Role?                   @relation(fields: [roleId], references: [id])
  withdrawalLimits        WithdrawalLimit?
  withdrawalsApproved     Withdrawal[]            @relation("approvedBy")
  withdrawalsCreated      Withdrawal[]            @relation("createdBy")

  @@map("users")
}

model Investment {
  id        String   @id @default(cuid())
  userId    String
  amount    Decimal  @db.Decimal(15, 2)
  plan      String
  status    String   @default("pending")
  roi       Decimal  @default(0) @db.Decimal(5, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("investments")
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String
  amount      Decimal  @db.Decimal(15, 2)
  description String?  @db.Text
  status      String   @default("pending")
  metadata    String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model Signal {
  id          String   @id @default(cuid())
  pair        String
  type        String
  direction   String?
  strength    String?
  source      String?
  entryPoint  String?
  entryPrice  String?
  stopLoss    String?
  takeProfit  String?
  takeProfit1 String?
  takeProfit2 String?
  takeProfit3 String?
  accuracy    String   @default("0%")
  reliability String?
  timeframe   String?
  status      String   @default("active")
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  creator     User?    @relation("createdBy", fields: [createdBy], references: [id])

  @@map("signals")
}

model Campaign {
  id          String    @id @default(cuid())
  name        String
  status      String    @default("draft")
  budget      Decimal?  @db.Decimal(15, 2)
  spent       Decimal   @default(0) @db.Decimal(15, 2)
  roi         Decimal   @default(0) @db.Decimal(5, 2)
  impressions Int       @default(0)
  clicks      Int       @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  creator     User?     @relation("createdBy", fields: [createdBy], references: [id])

  @@map("campaigns")
}

model Log {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  ipAddress String?
  status    String   @default("success")
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@map("logs")
}

model AdminPermission {
  id         String   @id @default(cuid())
  adminId    String
  permission String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, permission])
  @@map("admin_permissions")
}

model AdminUser {
  id          String        @id @default(cuid())
  userId      String        @unique
  status      String        @default("active")
  permissions String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  actions     AdminAction[]
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_users")
}

model AdminAction {
  id         String    @id @default(cuid())
  adminId    String
  action     String
  targetId   String?
  targetType String?
  changes    String?
  reason     String?
  ipAddress  String?
  status     String    @default("success")
  createdAt  DateTime  @default(now())
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_actions")
}

model AdminRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("admin_roles")
}

model MarketAnalysis {
  id        String   @id @default(cuid())
  asset     String
  price     String
  change    String?
  volume    String?
  marketCap String?
  high      String?
  low       String?
  trend     String?
  updatedAt DateTime @updatedAt

  @@map("market_analysis")
}

model Analysis {
  id          String            @id @default(cuid())
  title       String
  type        String
  symbol      String?
  content     String
  metricsData String?
  createdBy   String
  status      String            @default("draft")
  viewCount   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  creator     User              @relation("createdBy", fields: [createdBy], references: [id], onDelete: Cascade)
  comments    AnalysisComment[]
  metrics     AnalysisMetric[]

  @@map("analysis")
}

model AnalysisMetric {
  id          String   @id @default(cuid())
  analysisId  String
  metricName  String
  metricValue String?
  unit        String?
  createdAt   DateTime @default(now())
  analysis    Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@map("analysis_metrics")
}

model AnalysisComment {
  id         String   @id @default(cuid())
  analysisId String
  userId     String
  comment    String
  rating     Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("analysis_comments")
}

model AnalysisReport {
  id         String   @id @default(cuid())
  title      String
  period     String
  summary    String?
  statistics String?
  createdBy  String
  createdAt  DateTime @default(now())
  creator    User     @relation("createdBy", fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("analysis_reports")
}

model Broker {
  id             String          @id @default(cuid())
  name           String          @unique
  code           String          @unique
  logo           String?
  website        String?
  email          String?
  phone          String?
  country        String?
  status         String          @default("active")
  rating         Decimal         @default(0) @db.Decimal(3, 2)
  reviewCount    Int             @default(0)
  minimumDeposit Decimal?        @db.Decimal(15, 2)
  leverage       String?
  spreads        String?
  features       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accounts       BrokerAccount[]
  reviews        BrokerReview[]

  @@map("brokers")
}

model BrokerReview {
  id        String   @id @default(cuid())
  brokerId  String
  userId    String
  rating    Int
  comment   String?
  verified  Boolean  @default(false)
  helpful   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  broker    Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([brokerId, userId])
  @@map("broker_reviews")
}

model BrokerAccount {
  id            String   @id @default(cuid())
  userId        String
  brokerId      String
  accountNumber String?
  accountType   String?
  balance       Decimal  @default(0) @db.Decimal(15, 2)
  currency      String   @default("USD")
  status        String   @default("active")
  connectedAt   DateTime @default(now())
  broker        Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, brokerId])
  @@map("broker_accounts")
}

model BrokerComparison {
  id          String   @id @default(cuid())
  title       String
  description String?
  brokers     String?
  criteria    String?
  createdBy   String
  createdAt   DateTime @default(now())
  creator     User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("broker_comparisons")
}

model Notification {
  id        String                @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  data      String?
  read      Boolean               @default(false)
  readAt    DateTime?
  actionUrl String?
  createdAt DateTime              @default(now())
  history   NotificationHistory[]
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  emailNotifications Boolean  @default(true)
  pushNotifications  Boolean  @default(true)
  smsNotifications   Boolean  @default(false)
  inAppNotifications Boolean  @default(true)
  notificationTypes  String?
  quietHours         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model NotificationHistory {
  id             String        @id @default(cuid())
  notificationId String?
  userId         String
  deliveryMethod String
  status         String        @default("sent")
  sentAt         DateTime      @default(now())
  failureReason  String?
  notification   Notification? @relation(fields: [notificationId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_history")
}

model NotificationTemplate {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  subject   String?
  template  String
  variables String?
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_templates")
}

model BulkNotification {
  id             String    @id @default(cuid())
  title          String
  message        String
  recipientCount Int       @default(0)
  sentCount      Int       @default(0)
  failedCount    Int       @default(0)
  status         String    @default("draft")
  scheduledFor   DateTime?
  sentAt         DateTime?
  createdBy      String
  createdAt      DateTime  @default(now())
  creator        User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("bulk_notifications")
}

model SupportTicket {
  id             String           @id @default(cuid())
  userId         String
  subject        String
  description    String
  category       String
  priority       String           @default("medium")
  status         String           @default("open")
  assignedTo     String?
  attachments    String?
  resolution     String?
  resolutionTime Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  closedAt       DateTime?
  messages       SupportMessage[]
  assignee       User?            @relation("assignedTo", fields: [assignedTo], references: [id])
  creator        User             @relation("createdBy", fields: [userId], references: [id], onDelete: Cascade)

  @@map("support_tickets")
}

model SupportMessage {
  id          String        @id @default(cuid())
  ticketId    String
  userId      String
  message     String
  attachments String?
  isInternal  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("support_messages")
}

model SupportCategory {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  description  String?
  icon         String?
  responseTime Int?
  position     Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("support_categories")
}

model FaqArticle {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  category       String
  content        String
  keywords       String?
  imageUrl       String?
  viewCount      Int      @default(0)
  helpfulCount   Int      @default(0)
  unhelpfulCount Int      @default(0)
  author         String
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  creator        User     @relation("createdBy", fields: [author], references: [id], onDelete: Cascade)

  @@map("faq_articles")
}

model SupportAgent {
  id                String   @id @default(cuid())
  userId            String   @unique
  agentId           String   @unique
  department        String
  status            String   @default("offline")
  ticketsAssigned   Int      @default(0)
  avgResolutionTime Decimal? @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("support_agents")
}

model SupportMetric {
  id                    String   @id @default(cuid())
  period                String
  totalTickets          Int      @default(0)
  resolvedTickets       Int      @default(0)
  averageResolutionTime Decimal? @db.Decimal(10, 2)
  customerSatisfaction  Decimal? @db.Decimal(3, 2)
  avgFirstResponseTime  Decimal? @db.Decimal(10, 2)
  createdAt             DateTime @default(now())

  @@map("support_metrics")
}

model Withdrawal {
  id                 String                  @id @default(cuid())
  userId             String
  amount             Decimal                 @db.Decimal(15, 2)
  currency           String                  @default("USD")
  method             String
  status             String                  @default("pending")
  destinationDetails String?
  transactionId      String?
  reason             String?
  rejectionReason    String?
  approvedBy         String?
  approvedAt         DateTime?
  completedAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  approver           User?                   @relation("approvedBy", fields: [approvedBy], references: [id])
  user               User                    @relation("createdBy", fields: [userId], references: [id], onDelete: Cascade)
  accounts           UserWithdrawalAccount[] @relation("UserWithdrawalAccountToWithdrawal")

  @@map("withdrawals")
}

model WithdrawalMethod {
  id             String                  @id @default(cuid())
  name           String                  @unique
  code           String                  @unique
  description    String?
  icon           String?
  minAmount      Decimal?                @db.Decimal(15, 2)
  maxAmount      Decimal?                @db.Decimal(15, 2)
  fee            Decimal                 @default(0) @db.Decimal(5, 2)
  processingTime String?
  available      Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  accounts       UserWithdrawalAccount[]

  @@map("withdrawal_methods")
}

model UserWithdrawalAccount {
  id               String           @id @default(cuid())
  userId           String
  methodId         String
  accountName      String
  accountDetails   String?
  isDefault        Boolean          @default(false)
  verified         Boolean          @default(false)
  verificationCode String?
  createdAt        DateTime         @default(now())
  method           WithdrawalMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawals      Withdrawal[]     @relation("UserWithdrawalAccountToWithdrawal")

  @@map("user_withdrawal_accounts")
}

model WithdrawalReport {
  id                    String   @id @default(cuid())
  period                String
  totalRequests         Int      @default(0)
  totalAmount           Decimal  @default(0) @db.Decimal(15, 2)
  approvedAmount        Decimal  @default(0) @db.Decimal(15, 2)
  rejectedAmount        Decimal  @default(0) @db.Decimal(15, 2)
  averageProcessingTime Decimal? @db.Decimal(10, 2)
  createdAt             DateTime @default(now())

  @@map("withdrawal_reports")
}

model WithdrawalLimit {
  id               String    @id @default(cuid())
  userId           String    @unique
  dailyLimit       Decimal?  @db.Decimal(15, 2)
  monthlyLimit     Decimal?  @db.Decimal(15, 2)
  remainingDaily   Decimal?  @db.Decimal(15, 2)
  remainingMonthly Decimal?  @db.Decimal(15, 2)
  resetDate        DateTime?
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("withdrawal_limits")
}
